# Backend only. Never put the Meta API key in the Android app.
META_API_KEY=YOUR_META_API_KEY_HERE
# MODEL_API_KEY is also supported if META_API_KEY is unset.
# Audio additionally uses muse-voice-transcribe-1.0 at https://api.meta.ai/v1/asr/transcribe
# Fixed reasoning/vision model: muse-spark-1.3 (Standard); endpoint: https://api.meta.ai/v1/responses
KAVACH_LIVE_TOKEN=REPLACE_WITH_RANDOM_TOKEN
KAVACH_BIND=127.0.0.1
KAVACH_PORT=8765
# Required when serving beyond loopback:
# KAVACH_TLS_CERT=/absolute/path/to/server-cert.pem
# KAVACH_TLS_KEY=/absolute/path/to/server-key.pem
